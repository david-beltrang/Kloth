rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Los códigos de recuperación son exclusivos de Cloud Functions (Admin SDK).
    match /passwordResets/{document=**} {
      allow read, write: if false;
    }

    // Cualquier usuario autenticado puede leer y escribir en las demás colecciones.
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null && collection != 'passwordResets';
    }
  }
}
